# Copy to .env; every value shown is the default, so delete any line you don't need to change.

# Services
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Changing the embedding model means running `rag ingest` again.
EMBED_MODEL=nomic-embed-text
KNOWLEDGE_BASE_DIR=knowledge_base

# Answering
TOP_K=4
VERIFY_TOP_N=3
MAX_CLARIFY_TURNS=2
LLM_OFF_TOPIC_MIN_DISTANCE=0.40
OFF_TOPIC_MIN_DISTANCE=0.44

# Logging to Postgres; LOG_DEBUG=false keeps the question log but drops the debug traces.
LOG_QUESTIONS=true
LOG_DEBUG=true

# Discord bot (`rag discord`). Paste the bot token from the Discord Developer Portal into your
# .env only, never into code or chat. The staff role is pinged on handoffs (right-click the role
# with Developer Mode on, then Copy Role ID).
# DISCORD_TOKEN=
# DISCORD_STAFF_ROLE_ID=
